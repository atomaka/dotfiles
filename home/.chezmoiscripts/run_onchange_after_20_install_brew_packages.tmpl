#!/usr/bin/env bash

# packages.toml hash: {{ include (joinPath .chezmoi.sourceDir ".chezmoidata/packages.toml") | sha256sum }}

{{- if eq .chezmoi.os "darwin" }}

# Generate Brewfile content from packages.toml. Tap declarations run
# separately in run_onchange_after_15_install_brew_taps.tmpl, before this
# script, so trust is granted and persisted before any formula here can
# trigger a transitive-dependency load from a newly-trusted tap.
{
{{- range .packages.tool }}
{{- $managers := index . "managers" | default (list "brew" "pacman") }}
{{- $personal := index . "personal" }}
{{- if and (or (not $personal) $.personal) (has "brew" $managers) }}
  echo 'brew "{{ index . "brew" | default .name }}"'
{{- end }}
{{- end }}
{{- range .packages.tool }}
{{- $managers := index . "managers" | default (list "brew" "pacman") }}
{{- $personal := index . "personal" }}
{{- if and (or (not $personal) $.personal) (has "cask" $managers) }}
  echo 'cask "{{ index . "cask" | default .name }}"'
{{- end }}
{{- end }}
} | brew bundle --file=-

{{- end }}
